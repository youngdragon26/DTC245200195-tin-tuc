# ===== Sao chep file nay thanh .env roi DOI TAT CA mat khau =====
#   cp .env.example .env && nano .env
# File .env KHONG duoc commit len GitHub (da co trong .gitignore)

# Danh sach file compose duoc dung (Docker Compose tu doc bien nay)
#  - Commit 1: chi docker-compose.yml
#  - Commit 2: them docker-compose.monitoring.yml
#  - Commit 3: them docker-compose.logging.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.monitoring.yml:docker-compose.logging.yml

# IP cua may ao Linux (xem bang lenh: ip a)
SERVER_IP=192.168.1.100

# MySQL (mat khau manh: >= 16 ky tu, co chu hoa, thuong, so, ky tu dac biet)
MYSQL_ROOT_PASSWORD=DoiMatKhau_Root#2026xyz
APP_DB_USER=tintuc_app
APP_DB_PASSWORD=DoiMatKhau_App#2026xyz
EXPORTER_DB_PASSWORD=DoiMatKhau_Exp#2026xyz

# Tai khoan quan tri website
ADMIN_USERNAME=admin
ADMIN_PASSWORD=DoiMatKhau_Admin#2026xyz
# Chuoi ngau nhien >= 32 ky tu (tao bang: openssl rand -hex 32)
SESSION_SECRET=thay_bang_ket_qua_lenh_openssl_rand_hex_32

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=DoiMatKhau_Grafana#2026xyz
